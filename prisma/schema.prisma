// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  TEACHER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  role Role
  status AccountStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  refreshTokens RefreshToken[]
  classes Class[]
  students Student[]
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ClassStatus {
  ACTIVE
  INACTIVE
  COMPLETED
}

model Class {
  id         Int         @id @default(autoincrement())
  teacherId  Int         @map("teacher_id")
  teacher    User        @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Class_teacher_id_fkey")
  name       String      @db.VarChar(100)
  grade      Int         @db.SmallInt
  schoolYear String      @db.VarChar(20)
  subject    String      @db.VarChar(100)
  tuitionFee Decimal     @db.Decimal(12, 2)
  startDate  DateTime    @db.Date
  endDate    DateTime?   @db.Date
  status     ClassStatus @default(ACTIVE)
  note       String?     @db.Text
  createdAt  DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime    @updatedAt @db.Timestamptz(3)
  enrollments ClassStudent[]

  @@index([teacherId], map: "Class_teacher_id_idx")
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

model Student {
  id           String        @id @default(uuid()) @db.Uuid
  teacherId    Int           @map("teacher_id")
  teacher      User          @relation(fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "Student_teacher_id_fkey")
  fullName     String        @db.VarChar(150)
  phone        String?       @db.VarChar(20)
  parentName   String?       @db.VarChar(150)
  parentPhone  String?       @db.VarChar(20)
  school       String?       @db.VarChar(200)
  grade        Int?          @db.SmallInt
  dateOfBirth  DateTime?     @db.Date
  address      String?       @db.Text
  status       StudentStatus
  note         String?       @db.Text
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)
  enrollments  ClassStudent[]

  @@index([teacherId], map: "Student_teacher_id_idx")
}

enum EnrollmentStatus {
  ACTIVE
  LEFT
}

model ClassStudent {
  id          String           @id @default(uuid()) @db.Uuid
  classId     Int
  classRecord Class            @relation(fields: [classId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "ClassStudent_classId_fkey")
  studentId   String           @db.Uuid
  student     Student          @relation(fields: [studentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "ClassStudent_studentId_fkey")
  joinedAt    DateTime         @db.Date
  leftAt      DateTime?        @db.Date
  status      EnrollmentStatus
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  @@unique([classId, studentId], map: "ClassStudent_classId_studentId_key")
  @@index([studentId], map: "ClassStudent_studentId_idx")
}
