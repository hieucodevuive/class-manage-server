# Chép các biến này vào .env backend; tự điền credentials từ Cloudinary Console.
# Không commit .env hoặc đưa API Secret vào frontend/chat.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Origin backend mà frontend có thể truy cập; cần cấu hình khi deploy production.
PUBLIC_API_ORIGIN=http://localhost:5000

# Optional: URL ảnh mặc định riêng. Để trống thì dùng SVG có sẵn của backend.
DEFAULT_AVATAR_URL=
